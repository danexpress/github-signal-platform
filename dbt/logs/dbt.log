    create  table
      "warehouse"."main"."silver_actors_enriched__dbt_tmp"
  
    
    as (
      

-- Grain: one row per actor_id seen in silver_events.
-- Joins in-window behaviour (from GH Archive) with account metadata (from the
-- GitHub API) and derives a reputation_score used to weight stars downstream.
-- See findings.md F1 for why raw star counts need this.

with params as (
    -- v1 heuristic. Each component is scaled to [0, 1] and saturates at a
    -- threshold beyond which more of it says little about authenticity.
    select
        730.0 as age_saturation_days,       -- 2-year-old account = fully established
        100   as follower_saturation,       -- log-scaled
        20    as repo_saturation,           -- log-scaled
        0.30  as w_age,
        0.30  as w_followers,
        0.20  as w_repos,
        0.20  as w_engagement               -- did anything besides star in the window
),

events as (
    select * from "warehouse"."main"."silver_events"
),

window_bounds as (
    -- Account age is measured as of the end of the data window, not now(),
    -- so the model is reproducible when re-run later.
    select max(created_at) as window_end from events
),

activity as (
    select
        actor_id,
        arg_max(actor_login, created_at)                              as actor_login,
        bool_or(actor_is_bot)                                         as actor_is_bot,
        count(*)                                                      as events_in_window,
        count(*) filter (where event_type = 'WatchEvent')             as stars_in_window,
        count(*) filter (where event_type <> 'WatchEvent')            as non_star_events_in_window,
        count(distinct repo_id)                                       as distinct_repos_in_window,
        count(distinct event_type)                                    as distinct_event_types_in_window,
        min(created_at)                                               as first_seen_at,
        max(created_at)                                               as last_seen_at
    from events
    group by actor_id
),

profiles as (
    select *
    from read_parquet('s3://github-signal-raw/raw/github_users/**/*.parquet', hive_partitioning = true)
    qualify row_number() over (partition by actor_id order by fetched_at desc) = 1
),

joined as (
    select
        a.*,
        p.actor_id is not null                                        as is_enriched,
        p.lookup_status,
        p.login                                                       as profile_login,
        p.account_created_at,
        date_diff('day', p.account_created_at, w.window_end)         as account_age_days,
        p.followers,
        p.following,
        p.public_repos,
        p.fetched_at                                                  as profile_fetched_at
    from activity a
    cross join window_bounds w
    left join profiles p using (actor_id)
),

scored as (
    select
        j.*,
        least(greatest(j.account_age_days, 0) / prm.age_saturation_days, 1.0)          as age_component,
        least(ln(1 + j.followers) / ln(1 + prm.follower_saturation), 1.0)              as follower_component,
        least(ln(1 + j.public_repos) / ln(1 + prm.repo_saturation), 1.0)               as repo_component,
        case when j.non_star_events_in_window > 0 then 1.0 else 0.0 end                as engagement_component,
        prm.w_age, prm.w_followers, prm.w_repos, prm.w_engagement
    from joined j
    cross join params prm
)

select
    actor_id,
    actor_login,
    actor_is_bot,

    -- in-window behaviour
    events_in_window,
    stars_in_window,
    non_star_events_in_window,
    distinct_repos_in_window,
    distinct_event_types_in_window,
    first_seen_at,
    last_seen_at,

    -- account metadata
    is_enriched,
    lookup_status,
    profile_login,
    account_created_at,
    account_age_days,
    followers,
    following,
    public_repos,
    profile_fetched_at,

    -- reputation
    round(age_component, 4)        as age_component,
    round(follower_component, 4)   as follower_component,
    round(repo_component, 4)       as repo_component,
    engagement_component,
    case
        when actor_is_bot                    then 0.0
        when lookup_status = 'not_found'     then 0.0   -- deleted / suspended / spam-flagged
        when not is_enriched                 then null  -- unknown, not zero: let gold decide
        else round(
              w_age        * age_component
            + w_followers  * follower_component
            + w_repos      * repo_component
            + w_engagement * engagement_component
        , 4)
    end as reputation_score,
    case
        when actor_is_bot                    then 'bot'
        when lookup_status = 'not_found'     then 'gone'
        when not is_enriched                 then 'unknown'
        when w_age * age_component + w_followers * follower_component
           + w_repos * repo_component + w_engagement * engagement_component >= 0.6 then 'high'
        when w_age * age_component + w_followers * follower_component
           + w_repos * repo_component + w_engagement * engagement_component >= 0.3 then 'medium'
        else 'low'
    end as reputation_tier,

    current_timestamp as _processed_at
from scored
    );
    
  
