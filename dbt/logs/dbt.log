    create  table
      "warehouse"."main"."gold_authentic_trending__dbt_tmp"
  
    
    as (
      -- depends_on: "warehouse"."main"."silver_events"



with events as (
    select *
    from read_parquet('s3://github-signal-raw/silver/events/*.parquet')
    where actor_is_bot = false
      and repo_id is not null
),

actors as (
    select
        actor_id,
        coalesce(reputation_score, 0.1) as reputation_score
    from read_parquet('s3://github-signal-raw/silver/actors_enriched/data.parquet')
),

actors_scored as (
    select
        actor_id,
        -- Reputation score (computed here so we don't depend on what's in actors_enriched)
        -- Range roughly 0 to 5+
        case
            when coalesce(status, 'missing') != 'enriched' then 0.1       -- unenriched baseline
            when coalesce(account_type, 'User') = 'Organization' then 2.5  -- orgs are real entities
            else
                0.3 * ln(coalesce(followers, 0) + 1)
                + 0.2 * ln(coalesce(public_repos, 0) + 1)
                + 0.1 * (
                    cast(coalesce(has_bio, false) as int)
                    + cast(coalesce(has_company, false) as int)
                    + cast(coalesce(has_location, false) as int)
                    + cast(coalesce(has_custom_avatar, false) as int)
                )
                + 0.4 * least(
                    date_diff('year', coalesce(github_created_at, current_timestamp)::timestamp, current_timestamp),
                    3.0
                )
        end as reputation_score
    from actors
),

event_weights(event_type, weight) as (
    values
        ('WatchEvent', 3.0),
        ('ForkEvent', 5.0),
        ('PullRequestEvent', 10.0),
        ('IssuesEvent', 2.0),
        ('ReleaseEvent', 15.0),
        ('PullRequestReviewEvent', 4.0)
),

weighted_events as (
    select
        e.repo_id,
        e.repo_name,
        e.event_type,
        e.actor_id,
        e.created_at,
        w.weight as event_weight,
        coalesce(a.reputation_score, 0.1) as actor_reputation,
        w.weight * coalesce(a.reputation_score, 0.1) as authentic_event_score
    from events e
    inner join event_weights w on e.event_type = w.event_type
    left join actors_scored a on e.actor_id = a.actor_id
    where (e.event_type != 'PullRequestEvent' or e.payload_action = 'opened')
      and (e.event_type != 'IssuesEvent' or e.payload_action = 'opened')
),

repo_scored as (
    select
        repo_id,
        arg_max(repo_name, created_at) as repo_name,
        sum(authentic_event_score) as authentic_score,

        -- Score contributions by event type
        sum(case when event_type = 'WatchEvent' then authentic_event_score else 0 end)             as star_score,
        sum(case when event_type = 'ForkEvent' then authentic_event_score else 0 end)              as fork_score,
        sum(case when event_type = 'PullRequestEvent' then authentic_event_score else 0 end)       as pr_score,
        sum(case when event_type = 'IssuesEvent' then authentic_event_score else 0 end)            as issue_score,
        sum(case when event_type = 'ReleaseEvent' then authentic_event_score else 0 end)           as release_score,
        sum(case when event_type = 'PullRequestReviewEvent' then authentic_event_score else 0 end) as pr_review_score,

        -- Raw counts (for side-by-side comparison with gold_trending_repos)
        count(*) filter (where event_type = 'WatchEvent')              as raw_stars,
        count(*) filter (where event_type = 'ForkEvent')               as raw_forks,
        count(*) filter (where event_type = 'PullRequestEvent')        as raw_pr_opens,
        count(*) filter (where event_type = 'IssuesEvent')             as raw_issue_opens,
        count(*) filter (where event_type = 'ReleaseEvent')            as raw_releases,

        -- Average reputation of all actors touching this repo (high = quality audience)
        round(avg(actor_reputation)::numeric, 3) as avg_actor_reputation,
        round(max(actor_reputation)::numeric, 3) as max_actor_reputation,

        count(distinct actor_id) as unique_actors,

        min(created_at) as first_event_at,
        max(created_at) as last_event_at
    from weighted_events
    group by repo_id
)

select
    repo_id,
    repo_name,
    round(authentic_score::numeric, 2) as authentic_score,
    avg_actor_reputation,
    max_actor_reputation,
    unique_actors,
    round(star_score::numeric, 2)      as star_score,
    round(fork_score::numeric, 2)      as fork_score,
    round(pr_score::numeric, 2)        as pr_score,
    round(issue_score::numeric, 2)     as issue_score,
    round(release_score::numeric, 2)   as release_score,
    round(pr_review_score::numeric, 2) as pr_review_score,
    raw_stars,
    raw_forks,
    raw_pr_opens,
    raw_issue_opens,
    raw_releases,
    first_event_at,
    last_event_at,
    current_timestamp as _processed_at
from repo_scored
where authentic_score > 0
order by authentic_score desc
    );
    
  
