    create  table
      "warehouse"."main"."gold_trending_repos__dbt_tmp"
  
    
    as (
      

with events as (
    SELECT *
    FROM read_parquet('s3://github-signal-raw/silver/events/*.parquet')
    WHERE actor_is_bot = false
),

repo_counts as (
    SELECT
        repo_id,
        repo_name,


        COUNT(*) FILTER (WHERE event_type = 'WatchEvent')  AS stars,
        COUNT(*) FILTER (WHERE event_type = 'ForkEvent')   AS forks,
        COUNT(*) FILTER(
            WHERE event_type = 'PullRequestEvent' AND payload_action = 'opened'
        )                                                   AS pr_opens,
        COUNT(*) FILTER (
            WHERE event_type = 'IssuesEvent' AND payload_action = 'opened'
        )                                                    AS issue_opens,
        COUNT(*) FILTER (WHERE event_type = 'ReleaseEvent')  AS releases,
        COUNT(*) FILTER(WHERE event_type = 'PushEvent')      AS pushes,
        COUNT(*) FILTER(WHERE event_type = 'PullRequestReviewEvent') As pr_reviews,

        COUNT(DISTINCT actor_id) FILTER (WHERE event_type = 'WatchEvent') AS unique_starrers,
        COUNT(DISTINCT actor_id) FILTER (WHERE event_type = 'ForkEvent')  As  unique_forkers
        COUNT(DISTINCT actor_id) FILTER (WHERE event_type = 'PullRequestEvent') AS unique_pr_authors,

        COUNT(DISTINCT actor_id)                                                AS unique_human_actors,

        MIN(created_at)                                                         AS first_event_at,
        MAX(created_at)                                                         AS last_event_at,
    FROM events
    WHERE repo_id IS NOT NULL 
    GROUP BY repo_id, repo_name
),

scored AS (
    SELECT
        *,

    (
        stars * 3
        + forks * 5
        + pr_opens * 10
        + issues_opens * 2
        + releases * 15
        + pr_reviews * 14
    ) AS trending_score,

    CASE 
        WHEN stars = 0 THEN NULL
        ELSE ROUND(forks::NUMERIC / stars, 3)
    END AS fork_to_star_ratio,

    CASE
        WHEN stars > 20 AND forks = 0 AND pr_opens = 0 AND issue_opens = 0
            THEN true ELSE false
    END AS is_stars_only

    FROM repo_counts
)

SELECT
    repo_id,
    repo_name,
    trending_score,
    stars,
    forks,
    pr_opens,
    issue_opens,
    releases,
    pr_reviews,
    pushes,
    unique_starrers,
    unique_forkers,
    unique_pr_authors,
    unique_human_actors,
    fork_to_star_ratio,
    is_stars_only,
    first_event_at,
    last_event_at,
    current_timestamp AS _processed_at
FROM scored
WHERE trending_score > 0
ORDER BY trending_score DESC
    );
    
  
